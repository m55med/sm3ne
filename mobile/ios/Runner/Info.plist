<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HTTPS-only app, uses standard cryptography exemption (no custom crypto). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- App Transport Security: explicitly disable arbitrary loads.
	     All network traffic must go over HTTPS with modern TLS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>بصوتك يحتاج الوصول لمكتبة الصور لاختيار ملفات الصوت</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>بصوتك يحتاج الوصول للملفات لتحويل الصوت لنص</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Bisawtak</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>bisawtak</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- NO CFBundleDocumentTypes / LSSupportsOpeningDocumentsInPlace here, on
	     purpose. Declaring them makes iOS offer "Copy to/Open in Bisawtak" in the
	     share sheet, which LAUNCHES the full app on top of WhatsApp — the exact
	     behaviour the Share Extension exists to avoid. With both declared the app
	     showed up TWICE in the share sheet, one entry floating and one launching,
	     and users hit the launching one.

	     History, so this isn't restored a third time: build 45 removed them and
	     Bisawtak vanished from the share sheet entirely — but only because the
	     extension's activation rule was broken at the time (invalid key). Build 46
	     fixed that rule AND restored these as a safety net. The rule works now
	     (ShareExtension/Info.plist matches public.audio/movie/data), so the net is
	     no longer needed and was actively harmful.

	     Trade-off accepted: Bisawtak no longer appears under "Open with" for audio
	     files in the Files app. Forwarding from a chat app — the actual use case —
	     goes through the extension. Re-add this block to undo. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bisawtak</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.bisawtak.bisawtak</string>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.189277247383-tuai3fio03ut1p4g1vi4pp3673evkbp1</string>
			</array>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
		</dict>
	</array>
	<!-- Google Sign-In: iOS OAuth client ID. google_sign_in reads this when
	     no GoogleService-Info.plist is present (we don't use Firebase). -->
	<key>GIDClientID</key>
	<string>189277247383-tuai3fio03ut1p4g1vi4pp3673evkbp1.apps.googleusercontent.com</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>بصوتك يحتاج الوصول للميكروفون لتسجيل الصوت وتحويله لنص</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>يستخدم بصوتك التعرّف على الصوت داخل الجهاز لتحويل صوتك إلى نص بدون رفع التسجيل إلى الخادم.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
