# =============================================================================
# Database (REQUIRED — no default. App will refuse to start without this.)
# =============================================================================
DATABASE_URL=postgresql://bisawtak:bisawtak_pass@bisawtak-db:5432/bisawtak

# =============================================================================
# JWT (REQUIRED, must be at least 32 chars and NOT equal to "change-me".)
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_EXPIRE_MINUTES is the access-token TTL. 1440 (24h) is the current default;
# a future revision will likely move to a short access token (~15min) plus a long
# refresh token. Tokens carry iss=bisawtak, aud=bisawtak-app, and are invalidated
# when the user's password_changed_at timestamp moves past their iat.
# =============================================================================
SECRET_KEY=replace-with-token_urlsafe-48-output
TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# API-key pepper. HMAC-SHA256 secret used to hash issued API keys before
# storage. If unset, falls back to SECRET_KEY (a warning is logged on startup).
# Setting a dedicated value here means rotating SECRET_KEY won't invalidate keys.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NOTE: rotating API_KEY_PEPPER WILL invalidate every issued API key.
# =============================================================================
API_KEY_PEPPER=replace-with-token_urlsafe-48-output

# =============================================================================
# CORS — comma-separated allowlist of origins permitted to call the API.
# Default is the production admin/web origin. Add additional origins for dev.
# =============================================================================
CORS_ALLOWED_ORIGINS=https://voice.neojeen.com

# =============================================================================
# Rate-limit storage. Empty = in-memory (per-process only, fine for dev).
# For multi-worker / multi-host production, point at a shared store, e.g.:
#   RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
# =============================================================================
RATE_LIMIT_STORAGE_URI=

# Per-principal baseline rate limit applied to transcription endpoints.
RATE_LIMIT=10/minute

# Transcription provider: "speechmatics" | "gemini" | "groq" | "assemblyai".
# All providers are remote APIs. Auto-picks based on which provider key is set
# if unspecified.
TRANSCRIPTION_PROVIDER=speechmatics

# Language mode (applies to every provider below):
#   "auto"  → automatically detect the spoken language and transcribe in it
#             (an English/French voice note produces English/French text).
#   "ar"    → pin every transcription to Arabic (or any ISO 639-1 code).
# Default is "auto". Only pin a code if you truly want to force one language.

# Speechmatics
SP=your-speechmatics-api-token
SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=auto
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_POLL_INTERVAL=2.0
SPEECHMATICS_TIMEOUT_SECONDS=600

# Gemini (Google Generative AI)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_LANGUAGE_HINT=auto
# Lighter model used as a fallback for /transcriptions/translate when the
# primary GEMINI_MODEL returns a transient 503 ("model overloaded").
GEMINI_TRANSLATION_FALLBACK_MODEL=gemini-flash-lite-latest

# Groq Whisper (fastest Whisper inference, free daily tier)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=whisper-large-v3-turbo
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LANGUAGE=auto

# AssemblyAI (ASR with $50 free credit on signup)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ASSEMBLYAI_MODEL=universal
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v2
ASSEMBLYAI_LANGUAGE=auto

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@bisawtak.com

# =============================================================================
# Social Auth.
# - GOOGLE_CLIENT_ID empty → /auth/google returns 503.
# - APPLE_CLIENT_ID empty → /auth/apple returns 503 (no placeholder fallback).
# =============================================================================
GOOGLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=

# =============================================================================
# Admin bootstrap (REQUIRED — both username and password must be set; password
# must be at least 12 characters. No defaults are accepted.)
# =============================================================================
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@bisawtak.com

# =============================================================================
# Telegram Bot (optional — feature is auto-disabled when TELEGRAM_BOT_TOKEN
# is empty). When the token is set, TELEGRAM_WEBHOOK_SECRET is REQUIRED;
# the server will refuse to boot otherwise.
#
# Setup steps:
#   1. Create the bot via @BotFather → /newbot → copy the token here.
#   2. python -c "import secrets; print(secrets.token_urlsafe(32))" → put as secret.
#   3. Set TELEGRAM_BOT_USERNAME to the @handle without the @.
#   4. Set TELEGRAM_PUBLIC_BASE_URL to the origin the webhook is reachable at.
#   5. After first boot, the admin dashboard's "Register webhook" button
#      installs the URL + secret on Telegram. Or call setWebhook manually:
#      curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#           -d "url=<base>/api/v1/webhooks/telegram&secret_token=<SECRET>"
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PUBLIC_BASE_URL=https://voice.neojeen.com
TELEGRAM_API_BASE=https://api.telegram.org

# Surfaced to unlinked Telegram users in the "install the app" fallback. Empty
# values are silently dropped from the message at render time.
APP_STORE_URL=
PLAY_STORE_URL=
