# Database
DATABASE_URL=postgresql://bisawtak:bisawtak_pass@bisawtak-db:5432/bisawtak

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
TOKEN_EXPIRE_MINUTES=1440

# Whisper (local — used when TRANSCRIPTION_PROVIDER=whisper)
WHISPER_MODEL=large-v3
RATE_LIMIT=10/minute
WORKERS=3

# Transcription provider: "speechmatics" or "whisper". Auto-picks speechmatics if SP is set.
TRANSCRIPTION_PROVIDER=speechmatics

# Speechmatics (Batch ASR — much faster than local Whisper)
SP=your-speechmatics-api-token
SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=ar
SPEECHMATICS_OPERATING_POINT=enhanced
SPEECHMATICS_POLL_INTERVAL=2.0
SPEECHMATICS_TIMEOUT_SECONDS=600

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@bisawtak.com

# Social Auth
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# Admin (first admin user created on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@bisawtak.com
